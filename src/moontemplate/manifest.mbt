///|
/// Manifest helpers expose a stable machine-readable summary for packaging,
/// release notes, and acceptance evidence.
pub struct ProjectManifest {
  name : String
  version : String
  mut description : String
  features : Array[String]
  targets : Array[String]
} derive(Debug, Eq)

///|
pub fn ProjectManifest::new(name : String, version : String) -> ProjectManifest {
  { name, version, description: "", features: [], targets: [] }
}

///|
pub fn ProjectManifest::describe(
  self : ProjectManifest,
  description : String,
) -> ProjectManifest {
  self.description = description
  self
}

///|
pub fn ProjectManifest::feature(
  self : ProjectManifest,
  value : String,
) -> ProjectManifest {
  if value.trim() != "" && !self.features.contains(value) {
    self.features.push(value)
  }
  self
}

///|
pub fn ProjectManifest::target(
  self : ProjectManifest,
  value : String,
) -> ProjectManifest {
  if value.trim() != "" && !self.targets.contains(value) {
    self.targets.push(value)
  }
  self
}

///|
pub fn ProjectManifest::name(self : ProjectManifest) -> String {
  self.name
}

///|
pub fn ProjectManifest::version(self : ProjectManifest) -> String {
  self.version
}

///|
pub fn ProjectManifest::features(self : ProjectManifest) -> Array[String] {
  self.features.copy()
}

///|
pub fn ProjectManifest::targets(self : ProjectManifest) -> Array[String] {
  self.targets.copy()
}

///|
pub fn ProjectManifest::to_context(self : ProjectManifest) -> Context {
  Context::new()
  .set("name", self.name)
  .set("version", self.version)
  .set("description", self.description)
  .set("features", self.features.join(", "))
  .set("targets", self.targets.join(", "))
}

///|
pub fn ProjectManifest::to_json(self : ProjectManifest) -> String {
  json_object(self.to_context())
}

///|
pub fn ProjectManifest::to_markdown(self : ProjectManifest) -> String {
  markdown_heading(self.name, 1) +
  markdown_paragraph(self.description) +
  markdown_bullets(self.features)
}

///|
pub fn manifest_from_engine(
  name : String,
  version : String,
  engine : Engine,
) -> ProjectManifest {
  let manifest = ProjectManifest::new(name, version).describe(
    "Generated by MoonTemplate",
  )
  for filter in engine.filter_names() {
    let _ = manifest.feature("filter:" + filter)
  }
  for key in engine.required_variables() {
    let _ = manifest.feature("input:" + key)
  }
  manifest.target("wasm-gc").target("js").target("native")
}
